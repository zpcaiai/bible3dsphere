FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

COPY backend/digital_human/requirements-agent.txt /tmp/requirements-agent.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/requirements-agent.txt

COPY backend/digital_human /app/backend/digital_human

RUN useradd --create-home --uid 10001 agent \
    && chown -R agent:agent /app
USER agent

CMD ["python", "-m", "backend.digital_human.agent_worker", "start"]
