{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue_session.schema.json",
  "title": "DialogueSession",
  "type": "object",
  "required": [
    "session_id",
    "case_id",
    "stage",
    "difficulty",
    "consent",
    "status"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "D0",
        "D1",
        "D2",
        "D3",
        "D4",
        "D5"
      ]
    },
    "faith_context": {
      "enum": [
        "christian",
        "seeker",
        "unknown",
        "other"
      ]
    },
    "consent": {
      "type": "object"
    },
    "status": {
      "type": "string"
    },
    "active_hypothesis_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
