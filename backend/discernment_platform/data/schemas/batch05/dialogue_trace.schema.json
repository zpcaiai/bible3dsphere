{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue_trace.schema.json",
  "title": "DialogueTrace",
  "type": "object",
  "required": [
    "session_id",
    "events",
    "quality_gates",
    "review_status"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "review_status": {
      "enum": [
        "ready",
        "human_review_required",
        "safety_hold",
        "blocked"
      ]
    }
  }
}
