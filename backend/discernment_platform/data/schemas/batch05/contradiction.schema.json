{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contradiction.schema.json",
  "title": "DialogueTension",
  "type": "object",
  "required": [
    "tension_id",
    "statement_a",
    "statement_b",
    "tension_type",
    "confidence"
  ],
  "properties": {
    "tension_id": {
      "type": "string"
    },
    "statement_a": {
      "type": "string"
    },
    "statement_b": {
      "type": "string"
    },
    "tension_type": {
      "enum": [
        "logical",
        "value_behavior",
        "standard_asymmetry",
        "goal_method",
        "identity_action",
        "apparent_only"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "possible_reconciliation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up_question": {
      "type": "string"
    }
  }
}
