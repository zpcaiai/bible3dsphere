{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doctrinal_claim.schema.json",
  "title": "DoctrinalClaim",
  "type": "object",
  "required": [
    "claim_id",
    "text",
    "tier",
    "confidence",
    "source_status"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "TIER_1",
        "TIER_2",
        "TIER_3"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_status": {
      "enum": [
        "pack_validated",
        "scripture_reviewed",
        "tradition_specific",
        "human_review_required"
      ]
    },
    "denominational_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
