{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pastoral_case.schema.json",
  "title": "PastoralCase",
  "type": "object",
  "required": [
    "case_id",
    "subject_user_id",
    "purpose",
    "sensitivity",
    "status",
    "assigned_roles"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "subject_user_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "sensitivity": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "status": {
      "type": "string"
    },
    "assigned_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retention_policy": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
