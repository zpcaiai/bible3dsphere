{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recertification_event.schema.json",
  "title": "RecertificationEvent",
  "type": "object",
  "required": [
    "event_id",
    "release_id",
    "trigger_type",
    "triggered_at",
    "required_domains",
    "status"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "trigger_type": {
      "enum": [
        "model_change",
        "prompt_change",
        "policy_change",
        "pack_change",
        "new_data_source",
        "new_jurisdiction",
        "new_high_risk_feature",
        "incident",
        "metric_threshold",
        "authorization_change",
        "data_migration",
        "infrastructure_change",
        "scheduled_expiry"
      ]
    },
    "triggered_at": {
      "type": "string"
    },
    "required_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "passed",
        "failed",
        "certificate_suspended"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
