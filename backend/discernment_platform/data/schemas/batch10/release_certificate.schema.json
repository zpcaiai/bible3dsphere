{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release_certificate.schema.json",
  "title": "ProductionReleaseCertificate",
  "type": "object",
  "required": [
    "certificate_id",
    "release_id",
    "status",
    "issued_at",
    "expires_at",
    "scope",
    "domain_results",
    "signatories"
  ],
  "properties": {
    "certificate_id": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "NOT_EVALUATED",
        "EVALUATING",
        "BLOCKED",
        "CONDITIONAL_APPROVAL",
        "APPROVED_FOR_PILOT",
        "APPROVED_FOR_PRODUCTION",
        "SUSPENDED",
        "REVOKED"
      ]
    },
    "issued_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "domain_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "open_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepted_risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "feature_restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_target": {
      "type": "string"
    },
    "recertification_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signatories": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "signature_hash": {
      "type": "string"
    }
  }
}
