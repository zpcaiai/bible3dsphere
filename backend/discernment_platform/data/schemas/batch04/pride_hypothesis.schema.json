{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pride_hypothesis.schema.json",
  "title": "PrideHypothesis",
  "type": "object",
  "required": [
    "hypothesis_id",
    "pattern_id",
    "scope",
    "observation_ids",
    "evidence_level",
    "confidence",
    "alternative_explanations",
    "counter_evidence_needed",
    "status"
  ],
  "properties": {
    "hypothesis_id": {
      "type": "string"
    },
    "pattern_id": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "self",
        "public_person",
        "relationship",
        "group",
        "content_pattern"
      ]
    },
    "observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_level": {
      "enum": [
        "H0",
        "H1",
        "H2",
        "H3",
        "H4"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "interpretation": {
      "type": "string"
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counter_evidence_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triggering_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reinforcing_rewards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relational_costs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PROPOSED",
        "CLARIFYING",
        "TESTING",
        "SUPPORTED",
        "WEAKENED",
        "FALSIFIED",
        "FORMATION_PLAN",
        "REVIEWED",
        "INSUFFICIENT_EVIDENCE",
        "PASTORAL_SAFETY_HOLD",
        "HUMAN_REVIEW_REQUIRED"
      ]
    }
  }
}
