{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SocraticQuestionTree",
  "type": "object",
  "required": [
    "pack_id",
    "version",
    "mode",
    "stages"
  ],
  "properties": {
    "pack_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "mode": {
      "const": "adaptive_single_question"
    },
    "stages": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "questions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
