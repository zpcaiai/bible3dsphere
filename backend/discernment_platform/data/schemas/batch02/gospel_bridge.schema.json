    "version",
    "routes",
    "forbidden"
  ],
  "properties": {
    "pack_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object"
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
