{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/child-story-liturgy-plan-v1.json",
  "title": "ChildStoryLiturgyPlanV1",
  "description": "Reviewed story, questions and embodied response with Scripture/fiction and rights boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storyPlanId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "childRef",
    "storyType",
    "storyReference",
    "durationMinutes",
    "embodiedResponse",
    "fictionPresentedAsScripture",
    "copyrightedLongTextStored",
    "reviewStatus"
  ],
  "properties": {
    "storyPlanId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "childRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "storyType": {
      "enum": [
        "bible_story",
        "church_history",
        "virtue_story",
        "family_testimony",
        "literature",
        "nature_story"
      ]
    },
    "storyReference": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 2,
      "maximum": 45
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300,
        "minLength": 1
      },
      "maxItems": 6
    },
    "embodiedResponse": {
      "enum": [
        "draw",
        "act",
        "sing",
        "pray",
        "build",
        "retell",
        "serve",
        "none"
      ]
    },
    "fictionPresentedAsScripture": {
      "const": false
    },
    "copyrightedLongTextStored": {
      "const": false
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "theology_review",
        "pastoral_review",
        "child_safety_review",
        "legal_privacy_review",
        "approved",
        "retired"
      ]
    }
  }
}
