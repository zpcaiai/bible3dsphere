{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/embodied-play-plan-v1.json",
  "title": "EmbodiedPlayPlanV1",
  "description": "Embodied play plan with no ranking, forced moralization or location tracking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "playPlanId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "childRef",
    "playModes",
    "durationMinutes",
    "adultRole",
    "deviceFree",
    "performanceRankingEnabled",
    "forcedSpiritualLessonEnabled",
    "locationTrackingStored"
  ],
  "properties": {
    "playPlanId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "childRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "playModes": {
      "type": "array",
      "items": {
        "enum": [
          "outdoor",
          "pretend",
          "construction",
          "art",
          "music",
          "movement",
          "sensory",
          "nature",
          "cooperative_game",
          "household_work",
          "other"
        ]
      },
      "maxItems": 12,
      "minItems": 2,
      "uniqueItems": true
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 180
    },
    "adultRole": {
      "enum": [
        "available",
        "co_player",
        "observer",
        "guide",
        "safety_supervisor"
      ]
    },
    "deviceFree": {
      "type": "boolean"
    },
    "performanceRankingEnabled": {
      "const": false
    },
    "forcedSpiritualLessonEnabled": {
      "const": false
    },
    "locationTrackingStored": {
      "const": false
    }
  }
}
