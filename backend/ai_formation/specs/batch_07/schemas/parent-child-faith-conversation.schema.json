{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/parent-child-faith-conversation-v1.json",
  "title": "ParentChildFaithConversationV1",
  "description": "Open faith conversation where children may not know or disagree without belief scoring or secret solicitation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversationId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "childRef",
    "topic",
    "adultOpeningQuestion",
    "childMaySayDontKnow",
    "childMayDisagree",
    "beliefAnswerScored",
    "privateDisclosureSolicited",
    "rawChildWordsStored"
  ],
  "properties": {
    "conversationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "childRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "topic": {
      "enum": [
        "gratitude",
        "fear",
        "failure",
        "friendship",
        "prayer",
        "bible_question",
        "church_experience",
        "internet_content",
        "body_boundary",
        "help_seeking",
        "other"
      ]
    },
    "adultOpeningQuestion": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1
    },
    "childMaySayDontKnow": {
      "const": true
    },
    "childMayDisagree": {
      "const": true
    },
    "beliefAnswerScored": {
      "const": false
    },
    "privateDisclosureSolicited": {
      "const": false
    },
    "adultFollowUp": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "rawChildWordsStored": {
      "type": "boolean"
    }
  }
}
