{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/child-safety-disclosure-decision-v1.json",
  "title": "ChildSafetyDisclosureDecisionV1",
  "description": "Minimal child disclosure safety decision with no forensic interviewing or raw disclosure storage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disclosureDecisionId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "childRef",
    "concernCategory",
    "ordinaryActivityInterrupted",
    "absoluteConfidentialityPromised",
    "forensicQuestioningAllowed",
    "childBlamed",
    "rawDisclosureStored",
    "authorizedHumanOwnerRequired",
    "supportActions"
  ],
  "properties": {
    "disclosureDecisionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "childRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "concernCategory": {
      "enum": [
        "ordinary_question",
        "bullying",
        "unsafe_contact",
        "body_boundary_violation",
        "abuse",
        "sexual_content",
        "self_harm",
        "immediate_danger",
        "other"
      ]
    },
    "ordinaryActivityInterrupted": {
      "type": "boolean"
    },
    "absoluteConfidentialityPromised": {
      "const": false
    },
    "forensicQuestioningAllowed": {
      "const": false
    },
    "childBlamed": {
      "const": false
    },
    "rawDisclosureStored": {
      "const": false
    },
    "authorizedHumanOwnerRequired": {
      "const": true
    },
    "supportActions": {
      "type": "array",
      "items": {
        "enum": [
          "parent_or_guardian",
          "safeguarding_lead",
          "teacher",
          "licensed_professional",
          "emergency_service",
          "trusted_adult",
          "none"
        ]
      },
      "maxItems": 7,
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "safetyLevel": {
            "const": "S3"
          }
        },
        "required": [
          "safetyLevel"
        ]
      },
      "then": {
        "properties": {
          "ordinaryActivityInterrupted": {
            "const": true
          }
        }
      }
    }
  ]
}
