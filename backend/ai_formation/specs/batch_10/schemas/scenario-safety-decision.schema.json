{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/scenario-safety-decision-v1.json",
  "title": "ScenarioSafetyDecisionV1",
  "description": "Scenario safety decision that interrupts S3 and stores no raw disclosure/evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarioSafetyDecisionId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "runtimeSessionId",
    "signalCategory",
    "ordinaryScenarioInterrupted",
    "authorizedHumanOwnerRequired",
    "rawDisclosureStored",
    "explicitEvidenceUploaded",
    "clinicalOrLegalConclusionGenerated",
    "supportActions"
  ],
  "properties": {
    "scenarioSafetyDecisionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "runtimeSessionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "signalCategory": {
      "enum": [
        "none",
        "distress",
        "bullying",
        "harassment",
        "coercion",
        "abuse",
        "sexual_safety",
        "extortion",
        "self_harm",
        "suicidal_intent",
        "immediate_danger",
        "other"
      ]
    },
    "ordinaryScenarioInterrupted": {
      "type": "boolean"
    },
    "authorizedHumanOwnerRequired": {
      "type": "boolean"
    },
    "rawDisclosureStored": {
      "const": false
    },
    "explicitEvidenceUploaded": {
      "const": false
    },
    "clinicalOrLegalConclusionGenerated": {
      "const": false
    },
    "supportActions": {
      "type": "array",
      "items": {
        "enum": [
          "offer_break",
          "trusted_adult",
          "guardian",
          "safeguarding_lead",
          "licensed_professional",
          "emergency_service",
          "platform_report",
          "none"
        ]
      },
      "maxItems": 8,
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "safetyLevel": {
            "const": "S3"
          }
        },
        "required": [
          "safetyLevel"
        ]
      },
      "then": {
        "properties": {
          "ordinaryScenarioInterrupted": {
            "const": true
          },
          "authorizedHumanOwnerRequired": {
            "const": true
          }
        }
      }
    }
  ]
}
