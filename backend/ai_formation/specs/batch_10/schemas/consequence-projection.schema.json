{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/consequence-projection-v1.json",
  "title": "ConsequenceProjectionV1",
  "description": "Short/long consequence projections with uncertainty, repair and no deterministic future scoring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectionId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "choiceId",
    "horizons",
    "predictionPresentedAsCertain",
    "futureBehaviorScoreGenerated",
    "punishmentOnlyEndingAllowed",
    "repairPathIds"
  ],
  "properties": {
    "projectionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "choiceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "horizons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "horizon": {
            "enum": [
              "immediate",
              "one_day",
              "one_week",
              "one_month",
              "long_term"
            ]
          },
          "likelyFruits": {
            "type": "array",
            "items": {
              "enum": [
                "truth",
                "love",
                "peace",
                "responsibility",
                "repair",
                "wisdom",
                "connection",
                "avoidance",
                "shame",
                "conflict",
                "isolation",
                "sleep_loss",
                "deception",
                "risk",
                "other"
              ]
            },
            "maxItems": 16,
            "minItems": 1,
            "uniqueItems": true
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 360,
              "minLength": 1
            },
            "maxItems": 8
          }
        },
        "required": [
          "horizon",
          "likelyFruits",
          "uncertainties"
        ]
      },
      "maxItems": 5,
      "minItems": 1
    },
    "predictionPresentedAsCertain": {
      "const": false
    },
    "futureBehaviorScoreGenerated": {
      "const": false
    },
    "punishmentOnlyEndingAllowed": {
      "const": false
    },
    "repairPathIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 12,
      "uniqueItems": true
    }
  }
}
