{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/scenario-runtime-session-v1.json",
  "title": "ScenarioRuntimeSessionV1",
  "description": "Version-pinned resumable scenario runtime without raw free text or hidden profiling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtimeSessionId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "scenarioId",
    "scenarioVersion",
    "currentNodeId",
    "visitedNodeIds",
    "choiceEventIds",
    "sessionState",
    "facilitatorMode",
    "rawFreeTextStored",
    "hiddenPsychologicalProfileGenerated",
    "startedAt",
    "lastActiveAt"
  ],
  "properties": {
    "runtimeSessionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "scenarioVersion": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1
    },
    "currentNodeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "visitedNodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 100,
      "minItems": 1
    },
    "choiceEventIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 100
    },
    "sessionState": {
      "enum": [
        "started",
        "in_progress",
        "paused",
        "completed",
        "aborted",
        "safety_interrupted",
        "expired"
      ]
    },
    "facilitatorMode": {
      "enum": [
        "self_guided_adult",
        "parent_child",
        "teacher_group",
        "youth_mentor",
        "facilitated_individual"
      ]
    },
    "resumeTokenHash": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "rawFreeTextStored": {
      "const": false
    },
    "hiddenPsychologicalProfileGenerated": {
      "const": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastActiveAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
