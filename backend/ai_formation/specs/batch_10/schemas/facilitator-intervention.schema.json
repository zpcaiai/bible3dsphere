{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/facilitator-intervention-v1.json",
  "title": "FacilitatorInterventionV1",
  "description": "Facilitator intervention with anti-forensics, confidentiality and public-shame invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facilitatorInterventionId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "runtimeSessionId",
    "trigger",
    "recommendedAction",
    "facilitatorDecision",
    "facilitatorMayConductForensicInterview",
    "facilitatorMayPromiseAbsoluteConfidentiality",
    "learnerPubliclyShamed",
    "noteStored"
  ],
  "properties": {
    "facilitatorInterventionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "runtimeSessionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "trigger": {
      "enum": [
        "time_check",
        "confusion",
        "dominant_voice",
        "silence",
        "conflict",
        "sensitive_disclosure",
        "accessibility_need",
        "misinformation",
        "theology_error",
        "safety_signal",
        "other"
      ]
    },
    "recommendedAction": {
      "type": "string",
      "maxLength": 800,
      "minLength": 1
    },
    "facilitatorDecision": {
      "enum": [
        "continue",
        "reframe",
        "offer_skip",
        "pause",
        "move_private_with_policy",
        "handoff",
        "interrupt"
      ]
    },
    "facilitatorMayConductForensicInterview": {
      "const": false
    },
    "facilitatorMayPromiseAbsoluteConfidentiality": {
      "const": false
    },
    "learnerPubliclyShamed": {
      "const": false
    },
    "noteStored": {
      "type": "boolean"
    }
  }
}
