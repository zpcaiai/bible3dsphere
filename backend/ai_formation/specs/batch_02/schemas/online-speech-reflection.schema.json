{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/online-speech-reflection-v1.json",
  "title": "OnlineSpeechReflectionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reflectionId",
    "version",
    "context",
    "draftHandling",
    "serverDraftPersisted",
    "checks",
    "decision",
    "analyticsContentIncluded",
    "createdAt"
  ],
  "properties": {
    "reflectionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "context": {
      "enum": [
        "public_post",
        "comment",
        "direct_message",
        "group_chat",
        "email",
        "share_or_forward",
        "public_accusation"
      ]
    },
    "draftHandling": {
      "enum": [
        "ephemeral",
        "local_only"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truthChecked",
        "sourceChecked",
        "confidentialityProtected",
        "necessary",
        "lovingAndJust",
        "faceToFaceWilling",
        "angerState",
        "fatigueState"
      ],
      "properties": {
        "truthChecked": {
          "enum": [
            "yes",
            "no",
            "uncertain"
          ]
        },
        "sourceChecked": {
          "enum": [
            "yes",
            "no",
            "not_applicable",
            "uncertain"
          ]
        },
        "confidentialityProtected": {
          "enum": [
            "yes",
            "no",
            "uncertain"
          ]
        },
        "necessary": {
          "enum": [
            "yes",
            "no",
            "uncertain"
          ]
        },
        "lovingAndJust": {
          "enum": [
            "yes",
            "no",
            "uncertain"
          ]
        },
        "faceToFaceWilling": {
          "enum": [
            "yes",
            "no",
            "not_applicable",
            "uncertain"
          ]
        },
        "angerState": {
          "enum": [
            "calm",
            "elevated",
            "high",
            "prefer_not_to_say"
          ]
        },
        "fatigueState": {
          "enum": [
            "rested",
            "tired",
            "exhausted",
            "prefer_not_to_say"
          ]
        }
      }
    },
    "decision": {
      "enum": [
        "send",
        "revise",
        "wait",
        "delete",
        "talk_directly",
        "seek_mediation",
        "correct_publicly"
      ]
    },
    "delayUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "repairRequired": {
      "type": "boolean"
    },
    "analyticsContentIncluded": {
      "const": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "serverDraftPersisted": {
      "const": false
    }
  }
}
