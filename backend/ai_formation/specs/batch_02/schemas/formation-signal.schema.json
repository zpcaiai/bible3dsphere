{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/formation-signal-v1.json",
  "title": "FormationSignalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signalId",
    "version",
    "domainId",
    "direction",
    "intensity",
    "interpretationKey",
    "evidenceItemIds",
    "recommendedPracticeIds",
    "generatedAt"
  ],
  "properties": {
    "signalId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "domainId": {
      "enum": [
        "automatic_device_reach",
        "single_task_endurance",
        "silence_and_boredom",
        "notification_reactivity",
        "late_night_use",
        "prayer_reading_interruption",
        "emotional_escape",
        "immediate_gratification",
        "online_speech_reactivity",
        "comfort_avoidance",
        "responsibility_follow_through",
        "body_rhythm"
      ]
    },
    "direction": {
      "enum": [
        "support",
        "attention_needed"
      ]
    },
    "intensity": {
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "interpretationKey": {
      "type": "string",
      "pattern": "^sunday_school\\.ai_formation\\.adult\\.signal\\.[a-z0-9._-]+$"
    },
    "evidenceItemIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "maxItems": 12
    },
    "recommendedPracticeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "maxItems": 6
    },
    "diagnosticLabel": {
      "const": "none"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
