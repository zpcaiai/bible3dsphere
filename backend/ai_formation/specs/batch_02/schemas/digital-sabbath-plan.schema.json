{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/digital-sabbath-plan-v1.json",
  "title": "DigitalSabbathPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "version",
    "status",
    "cadence",
    "durationMinutes",
    "timeZone",
    "relationshipToLordDay",
    "setAsideCategories",
    "allowedExceptions",
    "replacementPractices",
    "preparationSteps",
    "authorityLevel",
    "isUniversalDivineCommand",
    "monitoringMode",
    "deviceNativeConsent",
    "createdAt"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "paused",
        "archived"
      ]
    },
    "cadence": {
      "enum": [
        "one_time",
        "weekly",
        "monthly",
        "custom"
      ]
    },
    "dayOfWeek": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 6
    },
    "startLocal": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 60,
      "maximum": 1440
    },
    "timeZone": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "relationshipToLordDay": {
      "enum": [
        "integrated",
        "separate",
        "church_configured",
        "not_specified"
      ]
    },
    "setAsideCategories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "social_media",
          "short_video",
          "news",
          "games",
          "shopping",
          "work_email",
          "entertainment",
          "all_nonessential"
        ]
      }
    },
    "allowedExceptions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "enum": [
          "emergency",
          "caregiving",
          "on_call_work",
          "travel",
          "medical",
          "accessibility",
          "church_service"
        ]
      }
    },
    "replacementPractices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "enum": [
          "worship",
          "sleep_and_rest",
          "family",
          "outdoors",
          "reading",
          "creative_work",
          "service",
          "meal_with_others",
          "silence_and_prayer"
        ]
      }
    },
    "preparationSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "enum": [
          "notify_contacts",
          "save_needed_information",
          "prepare_emergency_access",
          "finish_urgent_work",
          "choose_replacement_activity",
          "set_device_location",
          "invite_companion"
        ]
      }
    },
    "reentryReflectionTags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 6,
      "items": {
        "enum": [
          "more_rest",
          "more_presence",
          "more_anxiety",
          "strong_urge",
          "relational_connection",
          "spiritual_attention",
          "needs_adjustment",
          "uncertain"
        ]
      }
    },
    "authorityLevel": {
      "enum": [
        "PASTORAL_WISDOM",
        "PRODUCT_DEFAULT"
      ]
    },
    "isUniversalDivineCommand": {
      "const": false
    },
    "monitoringMode": {
      "enum": [
        "none",
        "user_enabled_device_native"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "deviceNativeConsent": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "monitoringMode": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "deviceNativeConsent": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "monitoringMode": {
            "const": "user_enabled_device_native"
          }
        }
      },
      "then": {
        "properties": {
          "deviceNativeConsent": {
            "const": true
          }
        }
      }
    }
  ]
}
