{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/formation-plan-v1.json",
  "title": "FormationPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "version",
    "track",
    "horizonDays",
    "status",
    "priorityDomains",
    "graceAnchor",
    "phases",
    "reviewCadence",
    "createdBy",
    "visibility",
    "createdAt"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "track": {
      "const": "adult_self_governance"
    },
    "horizonDays": {
      "enum": [
        7,
        14,
        30,
        90
      ]
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "archived"
      ]
    },
    "priorityDomains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "automatic_device_reach",
          "single_task_endurance",
          "silence_and_boredom",
          "notification_reactivity",
          "late_night_use",
          "prayer_reading_interruption",
          "emotional_escape",
          "immediate_gratification",
          "online_speech_reactivity",
          "comfort_avoidance",
          "responsibility_follow_through",
          "body_rhythm"
        ]
      }
    },
    "graceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentBlockId",
        "reminderKey"
      ],
      "properties": {
        "contentBlockId": {
          "type": "string"
        },
        "reminderKey": {
          "type": "string"
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phaseId",
          "startDay",
          "endDay",
          "practiceAssignments"
        ],
        "properties": {
          "phaseId": {
            "type": "string"
          },
          "startDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "endDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "practiceAssignments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "practiceId",
                "cadence",
                "minimumViableActionKey",
                "fallbackMode"
              ],
              "properties": {
                "practiceId": {
                  "type": "string"
                },
                "cadence": {
                  "enum": [
                    "daily",
                    "weekdays",
                    "weekly",
                    "triggered",
                    "custom"
                  ]
                },
                "targetOccurrences": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 90
                },
                "minimumViableActionKey": {
                  "type": "string"
                },
                "fallbackMode": {
                  "enum": [
                    "reduce_duration",
                    "reduce_frequency",
                    "replace_practice",
                    "pause_and_review"
                  ]
                },
                "fallbackPracticeId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reminderMode": {
                  "enum": [
                    "none",
                    "in_app",
                    "device_native_optional"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "supportOptions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2,
      "items": {
        "enum": [
          "trusted_friend",
          "spouse",
          "small_group",
          "pastor",
          "mentor",
          "licensed_professional",
          "none"
        ]
      }
    },
    "reviewCadence": {
      "enum": [
        "day_7",
        "weekly",
        "day_14_and_30",
        "every_30_days",
        "custom"
      ]
    },
    "adaptationPolicy": {
      "enum": [
        "gentle_default",
        "manual_only"
      ]
    },
    "createdBy": {
      "enum": [
        "learner",
        "teacher_assisted",
        "pastor_assisted",
        "system_assisted"
      ]
    },
    "visibility": {
      "enum": [
        "private",
        "shared_by_user"
      ]
    },
    "ruleOfLifeRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "digitalSabbathRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "bodyRhythmPlanRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
