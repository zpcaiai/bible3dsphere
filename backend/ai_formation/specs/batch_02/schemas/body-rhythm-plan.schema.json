{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/body-rhythm-plan-v1.json",
  "title": "BodyRhythmPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "version",
    "status",
    "components",
    "foodFastingSafety",
    "sensitiveHealthDetailsStored",
    "createdAt",
    "reviewAt"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "paused",
        "archived"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "type",
          "practiceId",
          "cadence"
        ],
        "properties": {
          "componentId": {
            "type": "string"
          },
          "type": {
            "enum": [
              "sleep_window",
              "wind_down",
              "wake_consistency",
              "movement",
              "outdoors",
              "meal_rhythm",
              "hydration",
              "caffeine_boundary",
              "non_food_fasting",
              "food_fasting",
              "rest"
            ]
          },
          "practiceId": {
            "type": "string"
          },
          "cadence": {
            "enum": [
              "daily",
              "weekdays",
              "weekly",
              "triggered",
              "custom"
            ]
          },
          "targetMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "startLocal": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "endLocal": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          }
        }
      }
    },
    "foodFastingSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adultConfirmed",
        "status",
        "professionalAdviceOverridesPlan"
      ],
      "properties": {
        "adultConfirmed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "not_selected",
            "eligible_self_attestation",
            "barrier_or_uncertain",
            "prefer_not_to_say",
            "excluded"
          ]
        },
        "professionalAdviceOverridesPlan": {
          "const": true
        }
      }
    },
    "sensitiveHealthDetailsStored": {
      "const": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "components": {
            "contains": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "food_fasting"
                }
              },
              "required": [
                "type"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "foodFastingSafety": {
            "properties": {
              "adultConfirmed": {
                "const": true
              },
              "status": {
                "const": "eligible_self_attestation"
              }
            }
          }
        }
      }
    }
  ]
}
