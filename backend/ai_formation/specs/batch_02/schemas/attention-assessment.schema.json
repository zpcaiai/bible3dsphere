{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/attention-self-assessment-v1.json",
  "title": "AttentionSelfAssessmentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessmentId",
    "version",
    "instrumentId",
    "targetTrack",
    "status",
    "responseStorage",
    "consentToPersistResponses",
    "responses",
    "startedAt"
  ],
  "properties": {
    "assessmentId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "instrumentId": {
      "const": "ai-formation.attention-self-governance.v1"
    },
    "targetTrack": {
      "const": "adult_self_governance"
    },
    "status": {
      "enum": [
        "in_progress",
        "completed",
        "discarded"
      ]
    },
    "responseStorage": {
      "enum": [
        "ephemeral",
        "persist_with_consent"
      ]
    },
    "consentToPersistResponses": {
      "type": "boolean"
    },
    "responses": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "domainId",
          "response"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^attn\\.[a-z0-9._-]{2,80}$"
          },
          "domainId": {
            "enum": [
              "automatic_device_reach",
              "single_task_endurance",
              "silence_and_boredom",
              "notification_reactivity",
              "late_night_use",
              "prayer_reading_interruption",
              "emotional_escape",
              "immediate_gratification",
              "online_speech_reactivity",
              "comfort_avoidance",
              "responsibility_follow_through",
              "body_rhythm"
            ]
          },
          "response": {
            "enum": [
              "never",
              "rarely",
              "sometimes",
              "often",
              "almost_always",
              "prefer_not_to_answer"
            ]
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signalIds",
        "recommendedPriorityDomains",
        "resultCompleteness",
        "userConfirmedPriorityDomains"
      ],
      "properties": {
        "signalIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "recommendedPriorityDomains": {
          "type": "array",
          "items": {
            "enum": [
              "automatic_device_reach",
              "single_task_endurance",
              "silence_and_boredom",
              "notification_reactivity",
              "late_night_use",
              "prayer_reading_interruption",
              "emotional_escape",
              "immediate_gratification",
              "online_speech_reactivity",
              "comfort_avoidance",
              "responsibility_follow_through",
              "body_rhythm"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        },
        "userConfirmedPriorityDomains": {
          "type": "array",
          "items": {
            "enum": [
              "automatic_device_reach",
              "single_task_endurance",
              "silence_and_boredom",
              "notification_reactivity",
              "late_night_use",
              "prayer_reading_interruption",
              "emotional_escape",
              "immediate_gratification",
              "online_speech_reactivity",
              "comfort_avoidance",
              "responsibility_follow_through",
              "body_rhythm"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        },
        "resultCompleteness": {
          "enum": [
            "limited",
            "sufficient",
            "strong"
          ]
        },
        "diagnosisGenerated": {
          "const": false
        },
        "salvationInferenceGenerated": {
          "const": false
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "discardedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "responseStorage": {
            "const": "ephemeral"
          }
        }
      },
      "then": {
        "properties": {
          "consentToPersistResponses": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "responseStorage": {
            "const": "persist_with_consent"
          }
        }
      },
      "then": {
        "properties": {
          "consentToPersistResponses": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "result",
          "completedAt"
        ],
        "properties": {
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "discarded"
          }
        }
      },
      "then": {
        "required": [
          "discardedAt"
        ],
        "properties": {
          "discardedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
