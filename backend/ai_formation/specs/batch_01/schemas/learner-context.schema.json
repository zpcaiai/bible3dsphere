{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/learner-context-v1.json",
  "title": "LearnerContextV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "ageBand",
    "locale",
    "goals",
    "consent"
  ],
  "properties": {
    "role": {
      "enum": [
        "learner",
        "parent",
        "teacher",
        "pastor",
        "guardian"
      ]
    },
    "ageBand": {
      "enum": [
        "0_6",
        "7_12",
        "13_15",
        "16_18",
        "adult"
      ]
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "attention",
          "digital_habits",
          "body_rhythm",
          "sexual_integrity",
          "ai_discernment",
          "family_liturgy",
          "parent_modeling",
          "identity",
          "relationships",
          "teacher_preparation"
        ]
      }
    },
    "churchContext": {
      "enum": [
        "local_church",
        "home_group",
        "school",
        "family_only",
        "unknown"
      ]
    },
    "accessibilityNeeds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      },
      "maxItems": 8
    },
    "deviceContext": {
      "enum": [
        "shared_device",
        "personal_device",
        "mixed",
        "none",
        "prefer_not_to_say"
      ]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataMinimizationAccepted"
      ],
      "properties": {
        "dataMinimizationAccepted": {
          "type": "boolean"
        },
        "guardianConfirmed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pastoralFollowupAllowed": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ageBand": {
            "enum": [
              "0_6",
              "7_12",
              "13_15",
              "16_18"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "consent": {
            "required": [
              "guardianConfirmed"
            ]
          }
        }
      }
    }
  ]
}
