{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/formation-content-block-v1.json",
  "title": "FormationContentBlockV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "authorityLevel",
    "body",
    "ageBands",
    "reviewStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "kind": {
      "enum": [
        "teaching",
        "scripture",
        "practice",
        "reflection",
        "scenario",
        "warning",
        "prayer"
      ]
    },
    "authorityLevel": {
      "enum": [
        "SCRIPTURE_EXPLICIT",
        "THEOLOGICAL_INFERENCE",
        "PASTORAL_WISDOM",
        "PRODUCT_DEFAULT"
      ]
    },
    "body": {
      "type": "object",
      "required": [
        "zh-CN"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "scriptureAnchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "usage"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 3
          },
          "usage": {
            "enum": [
              "primary",
              "supporting",
              "illustrative"
            ]
          },
          "contextNote": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "ageBands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "0_6",
          "7_12",
          "13_15",
          "16_18",
          "adult"
        ]
      }
    },
    "denominationalTags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 50
      }
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "theology_review",
        "pastoral_review",
        "approved",
        "rejected"
      ]
    },
    "reviewNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  }
}
