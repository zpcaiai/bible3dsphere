{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/trigger-timeline-v1.json",
  "title": "TriggerTimelineV1",
  "description": "Category-only trigger timeline for interruption and recovery; raw sexual content and third-party identities are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timelineId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "occurredAt",
    "contextCategories",
    "stateBefore",
    "urgeIntensity",
    "interruptionUsed",
    "supportContacted",
    "explicitMediaStored",
    "concreteSexualDetailStored",
    "thirdPartyIdentityStored",
    "diagnosisGenerated"
  ],
  "properties": {
    "timelineId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "contextCategories": {
      "type": "array",
      "items": {
        "enum": [
          "alone",
          "late_night",
          "bedroom",
          "bathroom",
          "travel",
          "work_break",
          "after_conflict",
          "after_rejection",
          "social_media",
          "ai_chat",
          "other"
        ]
      },
      "maxItems": 12,
      "minItems": 1,
      "uniqueItems": true
    },
    "stateBefore": {
      "type": "array",
      "items": {
        "enum": [
          "lonely",
          "anxious",
          "angry",
          "ashamed",
          "tired",
          "bored",
          "curious",
          "numb",
          "celebratory",
          "other"
        ]
      },
      "maxItems": 10,
      "minItems": 1,
      "uniqueItems": true
    },
    "urgeIntensity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "interruptionUsed": {
      "enum": [
        "leave_environment",
        "contact_support",
        "device_boundary",
        "breathing_and_prayer",
        "movement",
        "sleep",
        "meaningful_task",
        "none",
        "other"
      ]
    },
    "supportContacted": {
      "type": "boolean"
    },
    "explicitMediaStored": {
      "const": false
    },
    "concreteSexualDetailStored": {
      "const": false
    },
    "thirdPartyIdentityStored": {
      "const": false
    },
    "diagnosisGenerated": {
      "const": false
    }
  }
}
