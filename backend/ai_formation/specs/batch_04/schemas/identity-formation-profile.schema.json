{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/identity-formation-profile-v1.json",
  "title": "IdentityFormationProfileV1",
  "description": "Stores non-diagnostic identity anchors and pressures without sexual history or salvation inference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "identityAnchors",
    "receivedIdentityStatement",
    "salvationInferenceGenerated",
    "spiritualRankGenerated",
    "sexualHistoryStored"
  ],
  "properties": {
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "identityAnchors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 180,
        "minLength": 1
      },
      "maxItems": 10,
      "minItems": 1,
      "uniqueItems": true
    },
    "performancePressures": {
      "type": "array",
      "items": {
        "enum": [
          "appearance",
          "achievement",
          "career",
          "romance",
          "sexual_experience",
          "social_visibility",
          "spiritual_performance",
          "other"
        ]
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "comparisonSignals": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 180,
        "minLength": 1
      },
      "maxItems": 8
    },
    "receivedIdentityStatement": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1
    },
    "chosenEmbodiedAction": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "salvationInferenceGenerated": {
      "const": false
    },
    "spiritualRankGenerated": {
      "const": false
    },
    "sexualHistoryStored": {
      "const": false
    }
  }
}
