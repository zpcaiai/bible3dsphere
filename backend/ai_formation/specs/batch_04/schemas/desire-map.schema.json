{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/desire-map-v1.json",
  "title": "DesireMapV1",
  "description": "Maps triggers, desired goods and a human-chosen next action without raw fantasy or diagnosis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "desireMapId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "triggerCategories",
    "desiredGoods",
    "chosenNextAction",
    "rawFantasyStored",
    "explicitContentStored",
    "diagnosisGenerated"
  ],
  "properties": {
    "desireMapId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "triggerCategories": {
      "type": "array",
      "items": {
        "enum": [
          "loneliness",
          "rejection",
          "stress",
          "fatigue",
          "boredom",
          "shame",
          "anger",
          "curiosity",
          "comparison",
          "conflict",
          "unstructured_time",
          "other"
        ]
      },
      "maxItems": 12,
      "minItems": 1,
      "uniqueItems": true
    },
    "desiredGoods": {
      "type": "array",
      "items": {
        "enum": [
          "comfort",
          "belonging",
          "recognition",
          "control",
          "novelty",
          "rest",
          "intimacy",
          "escape",
          "power",
          "beauty",
          "reassurance",
          "other"
        ]
      },
      "maxItems": 10,
      "minItems": 1,
      "uniqueItems": true
    },
    "falsePromises": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240,
        "minLength": 1
      },
      "maxItems": 8
    },
    "embodiedSignals": {
      "type": "array",
      "items": {
        "enum": [
          "tension",
          "restlessness",
          "numbness",
          "racing_thoughts",
          "heat",
          "fatigue",
          "isolation_pull",
          "screen_pull",
          "other"
        ]
      },
      "maxItems": 10,
      "uniqueItems": true
    },
    "chosenNextAction": {
      "type": "string",
      "maxLength": 400,
      "minLength": 1
    },
    "rawFantasyStored": {
      "const": false
    },
    "explicitContentStored": {
      "const": false
    },
    "diagnosisGenerated": {
      "const": false
    }
  }
}
