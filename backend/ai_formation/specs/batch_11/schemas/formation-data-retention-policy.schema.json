{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/formation-data-retention-policy-v1.json",
  "title": "FormationDataRetentionPolicyV1",
  "description": "Purpose-bound retention with minor minimization and no indefinite default or silent purpose expansion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retentionPolicyId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "subjectType",
    "eventRetentionDays",
    "snapshotRetentionDays",
    "humanNoteRetentionDays",
    "aggregationAfterDays",
    "deleteRawEventsAfterAggregation",
    "minorDataMinimized",
    "safetyAuditExceptionDocumented",
    "indefiniteRetentionByDefault",
    "purposeExpansionWithoutConsentAllowed",
    "policyVersion"
  ],
  "properties": {
    "retentionPolicyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "subjectType": {
      "enum": [
        "adult_learner",
        "parent",
        "household",
        "child_supervised",
        "youth",
        "teacher"
      ]
    },
    "eventRetentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "snapshotRetentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "humanNoteRetentionDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "aggregationAfterDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "deleteRawEventsAfterAggregation": {
      "type": "boolean"
    },
    "minorDataMinimized": {
      "const": true
    },
    "safetyAuditExceptionDocumented": {
      "const": true
    },
    "indefiniteRetentionByDefault": {
      "const": false
    },
    "purposeExpansionWithoutConsentAllowed": {
      "const": false
    },
    "policyVersion": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1
    }
  }
}
