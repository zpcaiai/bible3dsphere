{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/attention-trajectory-v1.json",
  "title": "AttentionTrajectoryV1",
  "description": "Attention trajectory based on chosen practices, not raw device telemetry, browsing history or scores.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attentionTrajectoryId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "twinProfileId",
    "windowDays",
    "signals",
    "attentionScoreGenerated",
    "rawDeviceTelemetryUsed",
    "browsingHistoryUsed",
    "trend"
  ],
  "properties": {
    "attentionTrajectoryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "twinProfileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "windowDays": {
      "enum": [
        7,
        14,
        30,
        90
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "signal": {
            "enum": [
              "device_free_start",
              "single_task",
              "long_reading",
              "digital_sabbath",
              "late_night_boundary",
              "notification_reduction",
              "purposeful_unlock",
              "other"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "selfReportedFruit": {
            "enum": [
              "helpful",
              "neutral",
              "mixed",
              "unhelpful",
              "unknown"
            ]
          }
        },
        "required": [
          "signal",
          "attempts",
          "selfReportedFruit"
        ]
      },
      "maxItems": 12,
      "minItems": 1
    },
    "attentionScoreGenerated": {
      "const": false
    },
    "rawDeviceTelemetryUsed": {
      "const": false
    },
    "browsingHistoryUsed": {
      "const": false
    },
    "trend": {
      "enum": [
        "insufficient_data",
        "more_available",
        "stable",
        "less_available",
        "mixed"
      ]
    }
  }
}
