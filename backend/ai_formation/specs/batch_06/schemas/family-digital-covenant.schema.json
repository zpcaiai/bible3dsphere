{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/family-digital-covenant-v1.json",
  "title": "FamilyDigitalCovenantV1",
  "description": "Transparent, reasoned and reviewable family digital covenant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "covenantId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "householdId",
    "participants",
    "clauses",
    "memberVoiceRecorded",
    "appealAvailable",
    "secretRulesAllowed",
    "unilateralPermanentChangeAllowed",
    "reviewStatus"
  ],
  "properties": {
    "covenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "householdId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 12,
      "minItems": 1,
      "uniqueItems": true
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clauseId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
          },
          "area": {
            "enum": [
              "meals",
              "bedrooms",
              "homework",
              "worship",
              "travel",
              "social_media",
              "gaming",
              "ai_use",
              "privacy",
              "safety",
              "exceptions",
              "repair"
            ]
          },
          "rule": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "appliesTo": {
            "enum": [
              "all_members",
              "adults",
              "children",
              "teens",
              "role_specific"
            ]
          },
          "reviewDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "clauseId",
          "area",
          "rule",
          "reason",
          "appliesTo",
          "reviewDate"
        ]
      },
      "maxItems": 24,
      "minItems": 1
    },
    "memberVoiceRecorded": {
      "const": true
    },
    "appealAvailable": {
      "const": true
    },
    "secretRulesAllowed": {
      "const": false
    },
    "unilateralPermanentChangeAllowed": {
      "const": false
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "theology_review",
        "pastoral_review",
        "child_safety_review",
        "legal_privacy_review",
        "approved",
        "retired"
      ]
    }
  }
}
