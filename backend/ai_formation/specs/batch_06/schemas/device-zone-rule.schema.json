{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/device-zone-rule-v1.json",
  "title": "DeviceZoneRuleV1",
  "description": "Device-zone rules with emergency/accessibility exceptions and no covert sensing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneRuleId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "householdId",
    "zone",
    "deviceClasses",
    "ruleMode",
    "emergencyAccessPreserved",
    "accessibilityExceptionPreserved",
    "covertSensorUseAllowed"
  ],
  "properties": {
    "zoneRuleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "householdId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "zone": {
      "enum": [
        "meal_table",
        "bedroom",
        "bathroom",
        "worship_space",
        "homework_space",
        "vehicle",
        "shared_room",
        "outdoors",
        "other"
      ]
    },
    "deviceClasses": {
      "type": "array",
      "items": {
        "enum": [
          "phone",
          "tablet",
          "computer",
          "tv",
          "game_console",
          "wearable",
          "ai_device",
          "other"
        ]
      },
      "maxItems": 8,
      "minItems": 1,
      "uniqueItems": true
    },
    "ruleMode": {
      "enum": [
        "allowed",
        "not_allowed",
        "time_limited",
        "purpose_limited",
        "adult_present",
        "custom"
      ]
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300,
        "minLength": 1
      },
      "maxItems": 8
    },
    "emergencyAccessPreserved": {
      "const": true
    },
    "accessibilityExceptionPreserved": {
      "const": true
    },
    "covertSensorUseAllowed": {
      "const": false
    }
  }
}
