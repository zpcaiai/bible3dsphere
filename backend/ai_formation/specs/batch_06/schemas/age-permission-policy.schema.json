{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/age-permission-policy-v1.json",
  "title": "AgePermissionPolicyV1",
  "description": "Developmentally reviewed capability permissions with transparent reasons and no permanent ban after one failure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "permissionPolicyId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "householdId",
    "ageBandPolicy",
    "capabilities",
    "developmentalReviewRequired",
    "oneTimeFailureCausesPermanentBan",
    "secretPermissionChangesAllowed"
  ],
  "properties": {
    "permissionPolicyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "householdId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBandPolicy": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability": {
            "enum": [
              "messaging",
              "social_media",
              "gaming",
              "web_search",
              "ai_chat",
              "ai_creation",
              "purchases",
              "location_sharing",
              "camera_microphone",
              "downloads",
              "other"
            ]
          },
          "state": {
            "enum": [
              "not_allowed",
              "adult_present",
              "time_limited",
              "purpose_limited",
              "allowed_with_review",
              "self_governed"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1
          },
          "reviewDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "capability",
          "state",
          "reason",
          "reviewDate"
        ]
      },
      "maxItems": 20,
      "minItems": 1
    },
    "developmentalReviewRequired": {
      "const": true
    },
    "oneTimeFailureCausesPermanentBan": {
      "const": false
    },
    "secretPermissionChangesAllowed": {
      "const": false
    }
  }
}
