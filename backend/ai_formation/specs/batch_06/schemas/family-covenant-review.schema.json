{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/family-covenant-review-v1.json",
  "title": "FamilyCovenantReviewV1",
  "description": "Review of clauses and friction without family scoring, member comparison or private usage data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "householdId",
    "reviewPeriodDays",
    "familyScoreGenerated",
    "memberComparisonGenerated",
    "privateUsageDataIncluded",
    "nextReviewAt"
  ],
  "properties": {
    "reviewId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "householdId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "reviewPeriodDays": {
      "enum": [
        7,
        14,
        30,
        90
      ]
    },
    "workingClauses": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 24,
      "uniqueItems": true
    },
    "frictionClauses": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 24,
      "uniqueItems": true
    },
    "memberFeedbackSummary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 800
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500,
        "minLength": 1
      },
      "maxItems": 12
    },
    "familyScoreGenerated": {
      "const": false
    },
    "memberComparisonGenerated": {
      "const": false
    },
    "privateUsageDataIncluded": {
      "const": false
    },
    "nextReviewAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
