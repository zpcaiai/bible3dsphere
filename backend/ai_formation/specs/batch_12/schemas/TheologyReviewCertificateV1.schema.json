{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/theology-review-certificate-v1.json",
  "title": "TheologyReviewCertificateV1",
  "description": "Human theology review certificate tied to evidence and a defined statement of faith.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificateId",
    "scopeRef",
    "reviewerIds",
    "statementOfFaithVersion",
    "scriptureContextChecked",
    "authorityLayeringChecked",
    "gospelOrderChecked",
    "decision",
    "conditions",
    "evidenceRefs",
    "issuedAt",
    "expiresAt",
    "automatedApprovalAllowed"
  ],
  "properties": {
    "certificateId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "scopeRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "reviewerIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 10,
      "minItems": 1,
      "uniqueItems": true
    },
    "statementOfFaithVersion": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1
    },
    "scriptureContextChecked": {
      "type": "boolean"
    },
    "authorityLayeringChecked": {
      "type": "boolean"
    },
    "gospelOrderChecked": {
      "type": "boolean"
    },
    "denominationalVarianceNotes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3000
    },
    "decision": {
      "enum": [
        "pass",
        "pass_with_conditions",
        "fail"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500,
        "minLength": 1
      },
      "maxItems": 20
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 40,
      "minItems": 1,
      "uniqueItems": true
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "automatedApprovalAllowed": {
      "const": false
    }
  }
}
