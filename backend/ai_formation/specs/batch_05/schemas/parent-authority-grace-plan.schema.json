{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/parent-authority-grace-plan-v1.json",
  "title": "ParentAuthorityGracePlanV1",
  "description": "Transparent family authority, proportionate consequences, appeal and restoration with anti-humiliation invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorityPlanId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "ruleAreas",
    "reasonsExplained",
    "proportionateConsequences",
    "graceAndRestorationPath",
    "appealProcessAvailable",
    "humiliationAllowed",
    "physicalHarmAllowed",
    "spiritualThreatAllowed",
    "absoluteParentAuthorityClaimed"
  ],
  "properties": {
    "authorityPlanId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ruleAreas": {
      "type": "array",
      "items": {
        "enum": [
          "devices",
          "bedtime",
          "schoolwork",
          "chores",
          "speech",
          "church",
          "money",
          "friendships",
          "travel",
          "privacy",
          "other"
        ]
      },
      "maxItems": 12,
      "minItems": 1,
      "uniqueItems": true
    },
    "reasonsExplained": {
      "const": true
    },
    "proportionateConsequences": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300,
        "minLength": 1
      },
      "maxItems": 10,
      "minItems": 1
    },
    "graceAndRestorationPath": {
      "type": "string",
      "maxLength": 600,
      "minLength": 1
    },
    "appealProcessAvailable": {
      "const": true
    },
    "humiliationAllowed": {
      "const": false
    },
    "physicalHarmAllowed": {
      "const": false
    },
    "spiritualThreatAllowed": {
      "const": false
    },
    "absoluteParentAuthorityClaimed": {
      "const": false
    }
  }
}
