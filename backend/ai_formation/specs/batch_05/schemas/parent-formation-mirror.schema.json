{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/parent-formation-mirror-v1.json",
  "title": "ParentFormationMirrorV1",
  "description": "Parent modeling reflection without judging parental fitness or storing child narratives.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mirrorId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "modeledBehaviors",
    "statedValues",
    "chosenModelingAction",
    "childBlameGenerated",
    "parentFitnessInferenceGenerated",
    "privateChildNarrativeStored"
  ],
  "properties": {
    "mirrorId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "modeledBehaviors": {
      "type": "array",
      "items": {
        "enum": [
          "device_presence",
          "listening",
          "conflict",
          "repair",
          "work_boundaries",
          "rest",
          "prayer",
          "church_participation",
          "money",
          "service",
          "other"
        ]
      },
      "maxItems": 12,
      "minItems": 1,
      "uniqueItems": true
    },
    "statedValues": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 220,
        "minLength": 1
      },
      "maxItems": 10,
      "minItems": 1
    },
    "observedGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 260,
        "minLength": 1
      },
      "maxItems": 10
    },
    "chosenModelingAction": {
      "type": "string",
      "maxLength": 400,
      "minLength": 1
    },
    "childBlameGenerated": {
      "const": false
    },
    "parentFitnessInferenceGenerated": {
      "const": false
    },
    "privateChildNarrativeStored": {
      "const": false
    }
  }
}
