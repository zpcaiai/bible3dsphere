{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/parent-example-practice-plan-v1.json",
  "title": "ParentExamplePracticePlanV1",
  "description": "Short parent modeling plan with optional child participation and no public streaks or shame notifications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "practicePlanId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "durationDays",
    "focusAreas",
    "dailyMinimum",
    "weeklyPractice",
    "childParticipationOptional",
    "publicStreakEnabled",
    "shameNotificationEnabled",
    "reviewDate"
  ],
  "properties": {
    "practicePlanId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationDays": {
      "enum": [
        7,
        14,
        30
      ]
    },
    "focusAreas": {
      "type": "array",
      "items": {
        "enum": [
          "attention",
          "device_use",
          "listening",
          "repair",
          "rest",
          "prayer",
          "service",
          "speech",
          "success_pressure",
          "co_parenting"
        ]
      },
      "maxItems": 6,
      "minItems": 1,
      "uniqueItems": true
    },
    "dailyMinimum": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1
    },
    "weeklyPractice": {
      "type": "string",
      "maxLength": 400,
      "minLength": 1
    },
    "childParticipationOptional": {
      "const": true
    },
    "publicStreakEnabled": {
      "const": false
    },
    "shameNotificationEnabled": {
      "const": false
    },
    "reviewDate": {
      "type": "string",
      "format": "date"
    }
  }
}
