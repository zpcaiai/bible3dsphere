{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/media-desire-analysis-v1.json",
  "title": "MediaDesireAnalysisV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysisId",
    "version",
    "mediaType",
    "rawContentStored",
    "repetitionPattern",
    "emotionalTriggers",
    "desiredIdentity",
    "promisedReward",
    "fearedLoss",
    "actionInvitation",
    "shortTermFruit",
    "longTermFruit",
    "worshipDisplacementRisk",
    "diagnosisGenerated",
    "analyticsContainsPrivateReflection",
    "createdAt"
  ],
  "properties": {
    "analysisId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "mediaType": {
      "enum": [
        "short_video",
        "long_video",
        "music",
        "advertising",
        "social_feed",
        "game",
        "podcast",
        "news",
        "ai_companion",
        "other"
      ]
    },
    "contentLabel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "rawContentStored": {
      "const": false
    },
    "repetitionPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "emotionalTriggers": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "enum": [
          "wonder",
          "gratitude",
          "hope",
          "envy",
          "fear",
          "anger",
          "lust",
          "shame",
          "pride",
          "tribal_loyalty",
          "loneliness",
          "urgency",
          "other"
        ]
      }
    },
    "desiredIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "promisedReward": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "fearedLoss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "actionInvitation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "shortTermFruit": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "longTermFruit": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "relationshipImpact": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 700
    },
    "worshipDisplacementRisk": {
      "enum": [
        "low",
        "moderate",
        "high",
        "uncertain"
      ]
    },
    "userReflection": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1800
    },
    "diagnosisGenerated": {
      "const": false
    },
    "analyticsContainsPrivateReflection": {
      "const": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
