{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/algorithmic-worldview-analysis-v1.json",
  "title": "AlgorithmicWorldviewAnalysisV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysisId",
    "version",
    "artifactType",
    "objectiveFunctionHypotheses",
    "incentiveSignals",
    "anthropology",
    "telos",
    "authorityModel",
    "problemDefinition",
    "salvationPromise",
    "virtuesPromoted",
    "vicesExploited",
    "feedbackLoops",
    "uncertainty",
    "christianComparison",
    "automaticCondemnationGenerated",
    "diagnosisGenerated",
    "createdAt"
  ],
  "properties": {
    "analysisId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "artifactType": {
      "enum": [
        "feed",
        "recommender",
        "advertisement",
        "influencer_post",
        "search_results",
        "chatbot",
        "game",
        "ranking_system",
        "news_aggregation",
        "other"
      ]
    },
    "artifactLabel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "rawContentStored": {
      "const": false
    },
    "objectiveFunctionHypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "incentiveSignals": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "anthropology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanModel",
        "evidence"
      ],
      "properties": {
        "humanModel": {
          "enum": [
            "consumer",
            "creator",
            "data_source",
            "citizen",
            "worker",
            "disciple",
            "bodyless_self",
            "mixed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "telos": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "authorityModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "problemDefinition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "salvationPromise": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "virtuesPromoted": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "vicesExploited": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "excludedCosts": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "feedbackLoops": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "uncertainty": {
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "christianComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointsOfContact",
        "tensions",
        "authorityLevel"
      ],
      "properties": {
        "pointsOfContact": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "tensions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "authorityLevel": {
          "enum": [
            "SCRIPTURE_EXPLICIT",
            "THEOLOGICAL_INFERENCE",
            "PASTORAL_WISDOM",
            "PRODUCT_DEFAULT"
          ]
        }
      }
    },
    "automaticCondemnationGenerated": {
      "const": false
    },
    "diagnosisGenerated": {
      "const": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
