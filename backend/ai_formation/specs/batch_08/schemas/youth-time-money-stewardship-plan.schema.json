{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/youth-time-money-stewardship-plan-v1.json",
  "title": "YouthTimeMoneyStewardshipPlanV1",
  "description": "Youth time/money stewardship without family financial detail, wealth ranking or resource shame.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stewardshipPlanId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "youthRef",
    "timeBuckets",
    "moneyBuckets",
    "chosenAdjustment",
    "familyFinancialDetailsStored",
    "wealthRankGenerated",
    "shameForLowResourcesAllowed"
  ],
  "properties": {
    "stewardshipPlanId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "youthRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "timeBuckets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "sleep",
              "school",
              "work",
              "church",
              "family",
              "friends",
              "exercise",
              "creation",
              "service",
              "entertainment",
              "unstructured",
              "other"
            ]
          },
          "weeklyHours": {
            "type": "number",
            "minimum": 0,
            "maximum": 168
          }
        },
        "required": [
          "category",
          "weeklyHours"
        ]
      },
      "maxItems": 12,
      "minItems": 1
    },
    "moneyBuckets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "give",
              "save",
              "spend",
              "learn",
              "transport",
              "food",
              "subscriptions",
              "other"
            ]
          },
          "amountMinorUnits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3
          }
        },
        "required": [
          "category",
          "amountMinorUnits",
          "currency"
        ]
      },
      "maxItems": 10
    },
    "chosenAdjustment": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1
    },
    "familyFinancialDetailsStored": {
      "const": false
    },
    "wealthRankGenerated": {
      "const": false
    },
    "shameForLowResourcesAllowed": {
      "const": false
    }
  }
}
