{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/youth-digital-autonomy-plan-v1.json",
  "title": "YouthDigitalAutonomyPlanV1",
  "description": "Capability-level autonomy transfer with youth voice, review and no permanent one-failure rollback or secret monitoring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "autonomyPlanId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "youthRef",
    "capabilities",
    "youthVoiceRequired",
    "oneFailurePermanentRollback",
    "secretMonitoringAllowed",
    "parentMayReadAllMessagesByDefault"
  ],
  "properties": {
    "autonomyPlanId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "youthRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability": {
            "enum": [
              "device_time",
              "bedtime",
              "social_media",
              "ai_use",
              "downloads",
              "purchases",
              "location_sharing",
              "travel",
              "privacy",
              "other"
            ]
          },
          "currentLevel": {
            "enum": [
              "adult_decides",
              "adult_present",
              "shared_decision",
              "youth_proposes_adult_reviews",
              "youth_decides_with_review",
              "self_governed"
            ]
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 260,
              "minLength": 1
            },
            "maxItems": 8,
            "minItems": 1
          },
          "safetyBoundaries": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 260,
              "minLength": 1
            },
            "maxItems": 8,
            "minItems": 1
          },
          "reviewDate": {
            "type": "string",
            "format": "date"
          },
          "rollbackCondition": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1
          }
        },
        "required": [
          "capability",
          "currentLevel",
          "responsibilities",
          "safetyBoundaries",
          "reviewDate",
          "rollbackCondition"
        ]
      },
      "maxItems": 12,
      "minItems": 1
    },
    "youthVoiceRequired": {
      "const": true
    },
    "oneFailurePermanentRollback": {
      "const": false
    },
    "secretMonitoringAllowed": {
      "const": false
    },
    "parentMayReadAllMessagesByDefault": {
      "const": false
    }
  }
}
