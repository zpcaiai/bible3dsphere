{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/youth-formation-context-v1.json",
  "title": "YouthFormationContextV1",
  "description": "Youth autonomy and support context without secrets, diagnosis or spiritual-status inference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contextId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "youthRef",
    "ageStage",
    "currentAutonomyAreas",
    "supportNetworkRoles",
    "privateSecretSolicited",
    "spiritualStatusGenerated",
    "developmentalDiagnosisGenerated",
    "rawYouthNarrativeStored"
  ],
  "properties": {
    "contextId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "youthRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageStage": {
      "enum": [
        "13_15",
        "16_18"
      ]
    },
    "currentAutonomyAreas": {
      "type": "array",
      "items": {
        "enum": [
          "device_time",
          "bedtime",
          "social_media",
          "ai_use",
          "schoolwork",
          "money",
          "travel",
          "friendships",
          "church_participation",
          "privacy",
          "health_routine",
          "other"
        ]
      },
      "maxItems": 12,
      "minItems": 1,
      "uniqueItems": true
    },
    "supportNetworkRoles": {
      "type": "array",
      "items": {
        "enum": [
          "parent_or_guardian",
          "same_sex_mentor",
          "pastor",
          "teacher",
          "coach",
          "licensed_professional",
          "trusted_relative",
          "peer_support",
          "other"
        ]
      },
      "maxItems": 9,
      "minItems": 1,
      "uniqueItems": true
    },
    "privateSecretSolicited": {
      "const": false
    },
    "spiritualStatusGenerated": {
      "const": false
    },
    "developmentalDiagnosisGenerated": {
      "const": false
    },
    "rawYouthNarrativeStored": {
      "const": false
    }
  }
}
