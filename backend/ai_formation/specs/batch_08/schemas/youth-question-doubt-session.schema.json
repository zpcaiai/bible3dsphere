{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/youth-question-doubt-session-v1.json",
  "title": "YouthQuestionDoubtSessionV1",
  "description": "Truth-seeking doubt session with disagreement allowed and no belief scoring or conversion pressure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questionSessionId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "youthRef",
    "questionCategory",
    "questionSummary",
    "confidenceState",
    "sourcePlan",
    "youthMayDisagree",
    "beliefScoreGenerated",
    "conversionPressureAllowed",
    "privateConfessionSolicited"
  ],
  "properties": {
    "questionSessionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "youthRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "questionCategory": {
      "enum": [
        "god_existence",
        "scripture",
        "science",
        "suffering",
        "church_failure",
        "sexual_ethics",
        "other_religions",
        "prayer",
        "hypocrisy",
        "identity",
        "calling",
        "other"
      ]
    },
    "questionSummary": {
      "type": "string",
      "maxLength": 800,
      "minLength": 1
    },
    "confidenceState": {
      "enum": [
        "exploring",
        "uncertain",
        "provisional_view",
        "strong_view",
        "does_not_want_to_answer"
      ]
    },
    "sourcePlan": {
      "type": "array",
      "items": {
        "enum": [
          "scripture_context",
          "trusted_book",
          "pastor",
          "teacher",
          "parent",
          "scholar",
          "primary_source",
          "discussion_group",
          "other"
        ]
      },
      "maxItems": 9,
      "minItems": 1,
      "uniqueItems": true
    },
    "youthMayDisagree": {
      "const": true
    },
    "beliefScoreGenerated": {
      "const": false
    },
    "conversionPressureAllowed": {
      "const": false
    },
    "privateConfessionSolicited": {
      "const": false
    }
  }
}
