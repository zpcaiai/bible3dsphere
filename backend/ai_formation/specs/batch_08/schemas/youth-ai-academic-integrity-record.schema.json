{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/youth-ai-academic-integrity-record-v1.json",
  "title": "YouthAiAcademicIntegrityRecordV1",
  "description": "Youth AI learning integrity with policy, attempt, verification, disclosure and no evasion/fabrication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "integrityRecordId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "youthRef",
    "assignmentType",
    "policyState",
    "aiRolesUsed",
    "verificationCompleted",
    "detectionEvasionAssistanceAllowed",
    "fabricatedProcessAllowed",
    "finalAuthorshipOwner",
    "rawAssignmentStored"
  ],
  "properties": {
    "integrityRecordId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "youthRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "assignmentType": {
      "enum": [
        "essay",
        "code",
        "math",
        "science",
        "art",
        "presentation",
        "research",
        "language",
        "other"
      ]
    },
    "policyState": {
      "enum": [
        "allowed",
        "allowed_with_disclosure",
        "restricted",
        "not_allowed",
        "unknown_ask_teacher"
      ]
    },
    "independentAttemptSummary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "aiRolesUsed": {
      "type": "array",
      "items": {
        "enum": [
          "explain",
          "brainstorm",
          "feedback",
          "debug",
          "translate",
          "verify",
          "draft",
          "generate_final",
          "none"
        ]
      },
      "maxItems": 9,
      "minItems": 1,
      "uniqueItems": true
    },
    "verificationCompleted": {
      "type": "boolean"
    },
    "disclosureText": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "detectionEvasionAssistanceAllowed": {
      "const": false
    },
    "fabricatedProcessAllowed": {
      "const": false
    },
    "finalAuthorshipOwner": {
      "const": "youth"
    },
    "rawAssignmentStored": {
      "const": false
    }
  }
}
