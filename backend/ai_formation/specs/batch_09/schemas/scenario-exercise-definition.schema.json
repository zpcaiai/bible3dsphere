{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/scenario-exercise-definition-v1.json",
  "title": "ScenarioExerciseDefinitionV1",
  "description": "Reviewed scenario exercise using fictional cases rather than real sensitive histories.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exerciseId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "lessonId",
    "scenarioDefinitionId",
    "learningGoal",
    "roles",
    "choicePointIds",
    "debriefPromptSetId",
    "explicitSensitiveContentRendered",
    "learnerRealHistoryRequired",
    "shameEndingAllowed",
    "safetyReviewRequired",
    "reviewStatus"
  ],
  "properties": {
    "exerciseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "scenarioDefinitionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learningGoal": {
      "type": "string",
      "maxLength": 500,
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 180,
        "minLength": 1
      },
      "maxItems": 8,
      "minItems": 1
    },
    "choicePointIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 20,
      "minItems": 1,
      "uniqueItems": true
    },
    "debriefPromptSetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "explicitSensitiveContentRendered": {
      "const": false
    },
    "learnerRealHistoryRequired": {
      "const": false
    },
    "shameEndingAllowed": {
      "const": false
    },
    "safetyReviewRequired": {
      "const": true
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "theology_review",
        "pastoral_review",
        "child_safety_review",
        "legal_privacy_review",
        "approved",
        "retired"
      ]
    }
  }
}
