{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/unit-definition-v1.json",
  "title": "UnitDefinitionV1",
  "description": "Course unit sequence controlled by reviewed content, not silently reordered by a model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unitId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "courseId",
    "sequence",
    "title",
    "purpose",
    "lessonIds",
    "reviewStatus",
    "autoReorderedByModel",
    "contentVersion"
  ],
  "properties": {
    "unitId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "courseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "title": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "maxLength": 800,
      "minLength": 1
    },
    "lessonIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 30,
      "minItems": 1,
      "uniqueItems": true
    },
    "requiredPriorUnitIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 20,
      "uniqueItems": true
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "theology_review",
        "pastoral_review",
        "child_safety_review",
        "legal_privacy_review",
        "approved",
        "retired"
      ]
    },
    "autoReorderedByModel": {
      "const": false
    },
    "contentVersion": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1
    }
  }
}
