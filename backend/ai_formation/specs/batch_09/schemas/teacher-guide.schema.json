{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/teacher-guide-v1.json",
  "title": "TeacherGuideV1",
  "description": "Teacher guide with timing, questions, safety, adaptations and reviewer references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "teacherGuideId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "lessonId",
    "opening",
    "teachingOutline",
    "timingPlan",
    "facilitationWarnings",
    "safetyEscalationNotes",
    "reviewerRefs",
    "unreviewedAdvicePresentedAsApproved"
  ],
  "properties": {
    "teacherGuideId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "opening": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 1
    },
    "teachingOutline": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 800,
        "minLength": 1
      },
      "maxItems": 12,
      "minItems": 1
    },
    "timingPlan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segment": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          }
        },
        "required": [
          "segment",
          "minutes"
        ]
      },
      "maxItems": 20,
      "minItems": 1
    },
    "anticipatedQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500,
        "minLength": 1
      },
      "maxItems": 12
    },
    "facilitationWarnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 600,
        "minLength": 1
      },
      "maxItems": 12,
      "minItems": 1
    },
    "safetyEscalationNotes": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 1
    },
    "adaptations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500,
        "minLength": 1
      },
      "maxItems": 12
    },
    "reviewerRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
      },
      "maxItems": 10,
      "minItems": 1,
      "uniqueItems": true
    },
    "unreviewedAdvicePresentedAsApproved": {
      "const": false
    }
  }
}
