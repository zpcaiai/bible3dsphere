{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritual-planet.local/schemas/discussion-prompt-set-v1.json",
  "title": "DiscussionPromptSetV1",
  "description": "Non-leading, skippable discussion prompts without forced predetermined answer or confession.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "promptSetId",
    "version",
    "tenantId",
    "learnerId",
    "ageBand",
    "safetyLevel",
    "createdAt",
    "updatedAt",
    "lessonId",
    "prompts",
    "predeterminedAnswerRequired",
    "leadingConfessionAllowed",
    "peerPressureToDiscloseAllowed",
    "reviewStatus"
  ],
  "properties": {
    "promptSetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "ageBand": {
      "enum": [
        "early_childhood",
        "elementary",
        "younger_teen",
        "older_teen",
        "adult",
        "parent",
        "teacher"
      ]
    },
    "safetyLevel": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "promptId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
          },
          "question": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1
          },
          "questionType": {
            "enum": [
              "observation",
              "definition",
              "evidence",
              "assumption",
              "alternative",
              "worldview",
              "fruit",
              "application",
              "help_seeking"
            ]
          },
          "ageBands": {
            "type": "array",
            "items": {
              "enum": [
                "early_childhood",
                "elementary",
                "younger_teen",
                "older_teen",
                "adult",
                "parent",
                "teacher"
              ]
            },
            "maxItems": 7,
            "minItems": 1,
            "uniqueItems": true
          },
          "maySkip": {
            "const": true
          }
        },
        "required": [
          "promptId",
          "question",
          "questionType",
          "ageBands",
          "maySkip"
        ]
      },
      "maxItems": 20,
      "minItems": 1
    },
    "facilitatorFollowUps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500,
        "minLength": 1
      },
      "maxItems": 12
    },
    "predeterminedAnswerRequired": {
      "const": false
    },
    "leadingConfessionAllowed": {
      "const": false
    },
    "peerPressureToDiscloseAllowed": {
      "const": false
    },
    "reviewStatus": {
      "enum": [
        "draft",
        "theology_review",
        "pastoral_review",
        "child_safety_review",
        "legal_privacy_review",
        "approved",
        "retired"
      ]
    }
  }
}
