# MVFE — Minimum Viable Formation Engine
# Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================================
# LLM Provider (required for emotion/attention/decision extraction)
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (optional, used as embedding fallback)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# PostgreSQL (required for events, state, memories, drift log)
# ============================================================
POSTGRES_URL=postgresql://sfds:sfds_secret@localhost:5432/sfds

# ============================================================
# Neo4j (optional, for causal graph)
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sfds_neo4j_secret

# ============================================================
# Redis (optional, for caching / event buffer)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# MVFE Configuration
# ============================================================
# Drift threshold for self-evolving prompt updates
MVFE_DRIFT_THRESHOLD=0.15

# Max prompt updates per day (rate limiter)
MVFE_MAX_UPDATES_PER_DAY=3

# Entropy floor for prompt uncertainty
MVFE_ENTROPY_FLOOR=0.2

# Total error weights (must sum to 1.0)
MVFE_W_PRED=0.4
MVFE_W_ATTR=0.3
MVFE_W_LOOP=0.3
