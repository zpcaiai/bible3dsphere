# ============================================================
# SFDS v3 — Environment Configuration
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── PostgreSQL + pgvector ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sfds
POSTGRES_PASSWORD=sfds_secret
POSTGRES_DB=sfds
POSTGRES_URL=postgresql://sfds:sfds_secret@localhost:5432/sfds

# ── TimescaleDB ───────────────────────────────────────────────
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=sfds
TIMESCALE_PASSWORD=sfds_secret
TIMESCALE_DB=sfds_timescale
TIMESCALE_URL=postgresql://sfds:sfds_secret@localhost:5433/sfds_timescale

# ── Neo4j ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sfds_neo4j_secret

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ── System config ─────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Formation Engine ──────────────────────────────────────────
FORMATION_RECENCY_DECAY=0.92
FORMATION_SCORE_MIN=0.05
FORMATION_SCORE_MAX=0.95
FORMATION_CONFIDENCE_CAP=0.90

# ── Safety constraints (DO NOT CHANGE) ───────────────────────
SYSTEM_MAX_CONFIDENCE=0.90
SYSTEM_ALLOW_IDENTITY_LABELS=false
SYSTEM_ALLOW_MORAL_SCORING=false
