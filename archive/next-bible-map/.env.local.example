# 圣经地图模块环境变量
# Mapbox token（缺失时页面显示提示，不崩溃）
NEXT_PUBLIC_MAPBOX_TOKEN=
# Postgres 连接（缺失时 API 自动回退本地 seed 数据）
DATABASE_URL=
# Neo4j 关系图谱（可选；不配置则用本地内存图谱）
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# LLM AI 讲解（可选；不配置则返回模板文本。OpenAI 兼容）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
