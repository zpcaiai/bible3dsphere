// 圣经地图模块数据模型。
// 注：geojson/route 暂用 Json 存储以便本地快速跑通；后续可迁移到 PostGIS geometry(4326)+GIST。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BibleTerritory {
  id           String   @id @default(cuid())
  name         String
  nameZh       String
  ownerType    String
  ownerId      String?
  ownerName    String
  period       String
  startYear    Int
  endYear      Int?
  controlScore Int
  status       String
  color        String?
  geojson      Json
  geom         Unsupported("geometry(MultiPolygon, 4326)")?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerType, startYear, endYear])
}

model BibleMapEvent {
  id               String   @id @default(cuid())
  title            String
  titleZh          String
  category         String
  book             String?
  chapter          Int?
  startYear        Int
  endYear          Int?
  locationName     String?
  latitude         Float?
  longitude        Float?
  geojson          Json?
  geom             Unsupported("geometry(Point, 4326)")?
  description      String?
  spiritualMeaning String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category, startYear])
}

model BibleProphecy {
  id                      String   @id @default(cuid())
  book                    String
  chapterStart            Int
  chapterEnd              Int?
  targetNation            String
  targetNationZh          String
  prophecyType            String
  startYear               Int?
  fulfillmentYear         Int?
  sourceLocation          String
  targetLatitude          Float
  targetLongitude         Float
  geomTarget              Unsupported("geometry(Point, 4326)")? @map("geom_target")
  description             String
  fulfillmentDescription  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([book, chapterStart])
}

model BibleCampaign {
  id            String   @id @default(cuid())
  name          String
  nameZh        String
  commander     String?
  commanderZh   String?
  startYear     Int
  endYear       Int?
  book          String?
  chapter       Int?
  routeGeojson  Json
  geomRoute     Unsupported("geometry(LineString, 4326)")? @map("geom_route")
  pointsGeojson Json?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
