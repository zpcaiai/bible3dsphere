# ============================================================
# BibleSphere / MVFE — Backend Environment Template
# Copy to .env and fill in real values. NEVER commit .env.
# Every key below is actually read by the backend code
# (backend/**.py, query_emotion_verses.py, web_emotion_query.py,
# api/db-seed.js). Placeholders only — no real secrets.
# ============================================================

# ------------------------------------------------------------
# Server / app
# ------------------------------------------------------------
# HF Spaces serves on 7860 (hardcoded in Dockerfile CMD). PORT is only
# consumed by alternate deploy targets (e.g. Render startCommand $PORT).
PORT=8000
PUBLIC_BASE_URL=https://your-domain.com
# CORS: comma-separated origins. ALLOWED_FRONTENDS takes precedence, then ALLOWED_ORIGINS.
ALLOWED_FRONTENDS=
ALLOWED_ORIGINS=*
DEBUG_API=false
# AGENT_MODE=mock keeps deterministic offline LLM behaviour (used by tests / degradation)
AGENT_MODE=
THEOLOGICAL_SAFETY_REQUIRED=

# ------------------------------------------------------------
# Database (PostgreSQL / Neon)
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# ------------------------------------------------------------
# Auth / JWT / admin / cron
# ------------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_long_random_string
# Demo data is disabled by default. Only enable in an isolated demo environment,
# and always provide a unique password of at least 12 characters.
SEED_DEMO_USER=false
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=
# ADMIN_TOKEN authorizes the Vercel db-seed serverless function (api/db-seed.js)
ADMIN_TOKEN=your_admin_token
# CRON_SECRET: verified server-side for scheduled invocations (Vercel cron sends
# `Authorization: Bearer $CRON_SECRET`). Set the SAME value in Vercel env.
# Replaces the old ?token=... in URL cron pattern. See vercel.json.
CRON_SECRET=your_cron_secret
# Guards the Web Push cron endpoint
PUSH_CRON_SECRET=your_push_cron_secret

# ------------------------------------------------------------
# LLM Providers (narrative polish only; scoring/crisis stay deterministic)
# ------------------------------------------------------------
# Unified provider layer (provider defaults to openai)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_RETRIES=
LLM_TIMEOUT_SECONDS=
# Direct OpenAI (alternative to LLM_*)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_CHAT_KEY=your_gemini_chat_key
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_CHAT_URL=https://api.deepseek.com/v1/chat/completions
# SiliconFlow (bge-m3 embeddings + chat)
SILICONFLOW_API_KEY=your_siliconflow_api_key
# Google (Gemini/GenAI key used by mvfe vector layer)
GOOGLE_API_KEY=your_google_api_key

# ------------------------------------------------------------
# Embeddings (bge-m3 1024-dim semantic vectors; dimension is validated == 1024)
# ------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=
# OpenAI-compatible embedding endpoint (RAG / stronghold)
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_URL=https://api.openai.com/v1/embeddings
# query_emotion_verses.py fallback chain (must be bge-m3): primary -> SiliconFlow -> fallback -> synthetic
EMBED_PROVIDER=
EMBED_FALLBACK_URL=
EMBED_FALLBACK_KEY=
EMBED_FALLBACK_MODEL=BAAI/bge-m3
# Pause a provider this many seconds after 401/403 before retrying (0 = always retry)
EMBED_DISABLE_COOLDOWN_SEC=300
# Reranking / retrieval tuning (optional)
RERANK_MODEL_NAME=
LLM_RERANK_MODEL=
MMR_LAMBDA=
# Base URL for downloading prebuilt bible vectors at runtime
VECTOR_DATA_BASE_URL=
# Cache TTLs (seconds)
LLM_CACHE_TTL=
VERSE_CACHE_TTL=

# ------------------------------------------------------------
# TTS / audio
# ------------------------------------------------------------
GOOGLE_TTS_API_KEY=your_google_tts_key
GOOGLE_TTS_RATE=
# ElevenLabs (top-priority /api/tts engine; falls back to edge-tts then Google)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_MODEL=eleven_multilingual_v2
# Deepgram STT: server-only secret used by /api/speech/transcribe.
# In Hugging Face Spaces add this as a Secret, never as a VITE_* variable.
DEEPGRAM_API_KEY=your_deepgram_api_key
SPEECH_TRANSCRIBE_MAX_BYTES=10485760
# edge-tts prosody
EDGE_TTS_RATE_EN=
EDGE_TTS_RATE_ZH=

# ------------------------------------------------------------
# Stripe (billing)
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# One price id per plan: STRIPE_PRICE_<PLAN_KEY uppercased>, e.g. STRIPE_PRICE_PRO
STRIPE_PRICE_PRO=price_xxx

# ------------------------------------------------------------
# Cloudflare R2 (audio / video / seeker assets)
# ------------------------------------------------------------
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket
R2_SEEKERS_PREFIX=seekers/
R2_VIDEO_PREFIX=video/
VIDEO_CDN_BASE=

# ------------------------------------------------------------
# Web Push (VAPID)
# ------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@your-domain.com

# ------------------------------------------------------------
# Email (SMTP + transactional providers)
# ------------------------------------------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@your-domain.com
RESEND_API_KEY=your_resend_api_key
SENDGRID_API_KEY=your_sendgrid_api_key

# ------------------------------------------------------------
# HuggingFace (model/data pull + stats)
# ------------------------------------------------------------
HF_TOKEN=your_hf_token
HUGGINGFACE_TOKEN=your_hf_token
HF_DATA_REPO=your-username/your-data-repo
HF_STATS_REPO=your-username/your-stats-repo
HF_STATS_PATH=visit_stats.json

# ------------------------------------------------------------
# Kling (text->video / image->video)
# ------------------------------------------------------------
KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key
KLING_API_BASE=
KLING_MODEL=
KLING_T2V_MODEL=
KLING_MODE=
KLING_DUR_CAP=

# ------------------------------------------------------------
# Neo4j (optional causal / temporal graph)
# ------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ------------------------------------------------------------
# WebRTC voice (STUN/TURN + LiveKit SFU)
# ------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_TTL=3600
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=21600
LIVEKIT_E2EE=

# ------------------------------------------------------------
# WeChat OAuth
# ------------------------------------------------------------
WX_APP_ID=your_wx_app_id
WX_APP_SECRET=your_wx_app_secret
WX_REDIRECT_URI=https://your-domain.com/api/auth/wechat/callback

# ------------------------------------------------------------
# Crisis Care / notifications (optional; degrades to intent logging)
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
CRISIS_NOTIFY_WEBHOOK_URL=
CRISIS_CAREGIVER_ROLES=pastor,counselor,small_group_leader

# ------------------------------------------------------------
# Routing (OpenRouteService — bible-map)
# ------------------------------------------------------------
ORS_API_KEY=your_ors_api_key

# ------------------------------------------------------------
# Disciple worker (background scheduler)
# ------------------------------------------------------------
DISCIPLE_WORKER_ENABLED=
DISCIPLE_WORKER_INTERVAL=

# ------------------------------------------------------------
# OpenTelemetry tracing (optional; app no-ops if SDK/endpoint absent)
# ------------------------------------------------------------
OTEL_SERVICE_NAME=biblesphere-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=

# ------------------------------------------------------------
# Attention Stewardship release controls
# ------------------------------------------------------------
ATTENTION_MODULE_ENABLED=true
ATTENTION_AI_ENABLED=true
ATTENTION_COMMUNITY_ENABLED=true
ATTENTION_GROUPS_ENABLED=true
ATTENTION_ADMIN_ENABLED=true
ATTENTION_E2E_MODE=false
ATTENTION_DEMO_SEED_ENABLED=false
# Development/test only: comma-separated admin identities when the existing
# database-backed admin role is unavailable.
ATTENTION_ADMIN_EMAILS=

# ============================================================
# Frontend repo (bible3dsphereWeb) — NOT read by this backend.
# Kept here only as a reference for whoever sets Vercel/HF build vars.
# ============================================================
# VITE_HYMN_AUDIO_BASE=https://<r2-public-domain>/hymns
# VITE_BOOK_BASE=https://<r2-public-domain>/book
