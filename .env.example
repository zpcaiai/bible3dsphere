# ============================================================
# BibleSphere / MVFE — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it contains secrets.
# ============================================================

# ============================================================
# Server
# ============================================================
PORT=8000

# ============================================================
# Database (PostgreSQL / Neon)
# ============================================================
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# ============================================================
# LLM Providers
# ============================================================
GEMINI_API_KEY=your_gemini_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
SILICONFLOW_API_KEY=your_siliconflow_api_key
NEURONPEDIA_API_KEY=your_neuronpedia_api_key

# ============================================================
# Google Services (TTS, Search)
# ============================================================
GOOGLE_TTS_API_KEY=your_google_tts_key
GOOGLE_TTS_API_KEY1=your_google_tts_backup_key
GOOGLE_API_KEY1=your_google_api_key

# ============================================================
# Speech / Audio
# ============================================================
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs TTS —— /api/tts 最优先引擎，最接近真人的优美嗓音。
# 配了 ELEVENLABS_API_KEY 才启用；否则自动回退 edge-tts（温柔女声）→ Google。
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# 在 https://elevenlabs.io 的 Voice Library 选一个中文/多语女声，复制其 Voice ID 填这里。
# 默认 XrExE9yKIg1WjnnlVkGX = Matilda（温暖女声）。
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_MODEL=eleven_multilingual_v2
# 可选韵律微调（不填用默认）：stability 越低越有情感、style 越高越富表现力。
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_STYLE=0.35

# ============================================================
# Vector DB
# ============================================================
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=bible_cuv

# ============================================================
# WeChat OAuth
# ============================================================
WX_APP_ID=your_wx_app_id
WX_APP_SECRET=your_wx_app_secret
WX_REDIRECT_URI=https://your-domain.com/auth/wechat/callback

# ============================================================
# Email (SMTP)
# ============================================================
SMTP_FROM=noreply@your-domain.com
SMTP_HOST=smtp.your-provider.com
SMTP_PASS=your_smtp_password

# ============================================================
# HuggingFace
# ============================================================
HF_DATA_REPO=your-username/your-repo

# ============================================================
# MVFE — Formation Engine
# ============================================================
MVFE_DRIFT_THRESHOLD=0.15
MVFE_MAX_UPDATES_PER_DAY=3
MVFE_ENTROPY_FLOOR=0.2
MVFE_W_PRED=0.4
MVFE_W_ATTR=0.3
MVFE_W_LOOP=0.3

# ============================================================
# Neo4j (optional, for causal graph)
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ============================================================
# Redis (optional, for caching)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# 圣徒相通语音通话 — WebRTC STUN/TURN (见 docs/coturn-setup.md)
# ============================================================
# 自建 coturn 的 URL（逗号分隔）。留空则只用 STUN。
TURN_URLS=
# coturn static-auth-secret（use-auth-secret 模式）。设为 Secret，不要明文提交。
TURN_SECRET=
# TURN 临时凭据有效期（秒）
TURN_TTL=3600
# 可选：覆盖默认 Google 公共 STUN
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ── 多人群语音 (LiveKit SFU, Zoom 级音质) — backend/routers/voice.py ──────────
# 免费注册 https://cloud.livekit.io 建一个 project，在 Settings → Keys 拿到下面三项。
# Opus + RED 抗丢包 + 服务端回声消除 + 自带 TURN；可选 Krisp AI 降噪。
# 留空则 /api/voice/config 返回 enabled=false，前端给出配置引导，不影响其它功能。
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 进房令牌有效期（秒），默认 6 小时
LIVEKIT_TOKEN_TTL=21600

# ── 诗歌音频(Cloudflare R2) — emotion-sphere-ui/src/HymnPlayer.jsx ────────────
# 9 首圣诗 mp3 不再放进 git(HF 拒绝裸二进制)，改托管在 R2 桶 sabbath 下 hymns/ 前缀。
# 这是【前端构建期】变量(Vite)，需在 Vercel 项目变量 + HF 构建环境都设置：
#   VITE_HYMN_AUDIO_BASE=https://<你的R2公开域名>/hymns
# 例：自定义域 https://cdn.holiness.uk/hymns  或  https://pub-xxxx.r2.dev/hymns
# 未设置时前端回退到本地 /hymns（仅开发用，线上无文件会优雅显示“音频待添加”）。
VITE_HYMN_AUDIO_BASE=

# ── 属灵书籍 EPUB 全文(Cloudflare R2) — emotion-sphere-ui/src/SpiritualBooksPage.jsx ──
# EPUB 原著(部分达数十 MB)不入 git，托管在 R2 桶 sabbath 下 book/ 前缀。
# 前端构建期变量(Vite)，需在部署环境(Netlify/Vercel/HF)设置：
#   VITE_BOOK_BASE=https://<你的R2公开域名>/book   例：https://cdn.holiness.uk/ebook
# 未设置时：localhost 走本地 public/book/；线上默认回退 https://cdn.holiness.uk/ebook。
# 注意：EPUB 由 epub.js 经 XHR 读取，CDN/R2 须开启 CORS(Access-Control-Allow-Origin)。
VITE_BOOK_BASE=

# ── 语音安全/墙内部署 — 见 docs/voice-security-china.md ───────────────────────
# 通话内容默认仅"链路加密"(LiveKit 服务器可解)。需"服务器也听不到"时，在通话内
# 设置"加密口令"开启端到端加密(E2EE)，口令仅存本地、不上送。
# 墙内连通性差时建议自托管 LiveKit 于 香港/新加坡/东京，TLS+TURN 跑 443：
#   LIVEKIT_URL=wss://rtc.yourdomain.com   # 自托管地址(令牌签发逻辑不变)
